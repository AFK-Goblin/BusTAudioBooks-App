{
  "expo": {
    "name": "BusTAudioBooks",
    "slug": "bustaudio",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15101c",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.bustaudio.app",
      "versionCode": 3,
      "backgroundColor": "#15101c",
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15101c"
      }
    },
    "runtimeVersion": "3.0.0",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/836379ac-471a-4dd9-90d0-954f2fd42401"
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "836379ac-471a-4dd9-90d0-954f2fd42401"
      }
    },
    "ios": {},
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#15101c",
          "imageWidth": 200
        }
      ],
      "@kesha-antonov/react-native-background-downloader"
    ]
  }
}
