<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/bustaudio_widget_background">
    <LinearLayout android:id="@+id/widget_book" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_cover" android:layout_width="54dp" android:layout_height="64dp" android:scaleType="centerCrop" android:src="@drawable/bustaudio_widget_book" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BusTAudio" android:textColor="#f6f0ff" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/widget_chapter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Open the app and choose a book" android:textColor="#c4b5cf" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp" android:progressTint="#a78bfa" android:progressBackgroundTint="#42324f" android:max="100" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_position" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ready to listen" android:textSize="11sp" android:textColor="#c4b5cf" android:maxLines="2" />
        <TextView android:id="@+id/widget_back" android:layout_width="48dp" android:layout_height="48dp" android:text="−15" android:textSize="14sp" android:textStyle="bold" android:textColor="#eee5f7" android:gravity="center" android:background="@drawable/bustaudio_widget_button" android:contentDescription="Back 15 seconds" />
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:padding="12dp" android:src="@drawable/bustaudio_widget_play" android:background="@drawable/bustaudio_widget_primary" android:contentDescription="Open BusTAudio" />
        <TextView android:id="@+id/widget_forward" android:layout_width="48dp" android:layout_height="48dp" android:text="+30" android:textSize="14sp" android:textStyle="bold" android:textColor="#eee5f7" android:gravity="center" android:background="@drawable/bustaudio_widget_button" android:contentDescription="Forward 30 seconds" />
    </LinearLayout>
</LinearLayout>
