<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bustaudio_widget_background">
    <LinearLayout android:id="@+id/widget_book" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_cover" android:layout_width="32dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/bustaudio_widget_book" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BusTAudio" android:textColor="#f6f0ff" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"  />
            <TextView android:id="@+id/widget_chapter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a book" android:textColor="#c4b5cf" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:progressTint="#a78bfa" android:progressBackgroundTint="#42324f" android:max="100" />
    <TextView android:id="@+id/widget_position" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:textSize="9sp" android:includeFontPadding="false" android:textColor="#c4b5cf" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="−15" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:textColor="#eee5f7" android:gravity="center" android:maxLines="1" android:background="@drawable/bustaudio_widget_button" android:contentDescription="Back 15 seconds" />
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="36dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="8dp" android:src="@drawable/bustaudio_widget_play" android:background="@drawable/bustaudio_widget_primary" android:contentDescription="Open BusTAudio" />
        <TextView android:id="@+id/widget_forward" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="+30" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:textColor="#eee5f7" android:gravity="center" android:maxLines="1" android:background="@drawable/bustaudio_widget_button" android:contentDescription="Forward 30 seconds" />
    </LinearLayout>
</LinearLayout>
